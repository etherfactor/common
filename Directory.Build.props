<Project>
  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>EtherGizmos.Common</RootNamespace>
    <AssemblyName>EtherGizmos.Common.$(MSBuildProjectName)</AssemblyName>
  </PropertyGroup>
</Project>
